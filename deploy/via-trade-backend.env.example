ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080

ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=ViaTradeDb;User=viatrade;Password=CHANGE_ME;
ConnectionStrings__Redis=127.0.0.1:6379
Jwt__Secret=GENERATE_A_LONG_RANDOM_SECRET
ServiceSecurity__Password=GENERATE_A_LONG_RANDOM_SERVICE_PASSWORD
TelegramBot__BotUsername=ViaTradeBot
TelegramNotifications__RedisDatabase=1
TelegramNotifications__StreamName=telegram:notifications
TelegramNotifications__MaxLength=100000
TelegramNotifications__ReminderPublishIntervalSeconds=30
ReminderCleanup__RetentionDays=30
ReminderCleanup__CleanupIntervalHours=24
ReminderLimits__MaxRemindersPerUser=3000

AnalyzerData__SourcePath=/srv/viatrade-analyzer/data
AnalyzerData__FuturesDataDirectoryName=futures
AnalyzerData__StocksDataDirectoryName=stocks
AnalyzerData__StrategyResultDirectoryName=result/strategy
AnalyzerData__ScrennerResultDirectoryName=result/screnner
