<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<RootNamespace>ViaTrade.Api</RootNamespace>
		<AssemblyName>ViaTrade.Api</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>5001262e-6237-421d-b09e-f4956f03d30c</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Authentication\**" />
		<Content Remove="Authentication\**" />
		<EmbeddedResource Remove="Authentication\**" />
		<None Remove="Authentication\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.Development.json">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MicroElements.Swashbuckle.FluentValidation" Version="7.2.2" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Scrutor" Version="7.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
		<ProjectReference Include="..\Configuration\Configuration.csproj" />
	</ItemGroup>

	<ItemGroup>
		<SwaggerDocument Include="web" OutputPath="$(ProjectDir)..\swagger\swagger.yaml" />
		<SwaggerDocument Include="tgbot" OutputPath="$(ProjectDir)..\swagger\swagger-tgbot.yaml" />
		<SwaggerDocument Include="analyzer" OutputPath="$(ProjectDir)..\swagger\swagger-analyzer.yaml" />
	</ItemGroup>

	<Target Name="GenerateSwagger" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
		<PropertyGroup>
			<_SwaggerIntermediateDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'swagger'))</_SwaggerIntermediateDirectory>
		</PropertyGroup>

		<ItemGroup>
			<_GeneratedSwaggerDocument Include="@(SwaggerDocument)">
				<GeneratedPath>$(_SwaggerIntermediateDirectory)\%(Identity).yaml</GeneratedPath>
			</_GeneratedSwaggerDocument>
		</ItemGroup>

		<MakeDir Directories="$(ProjectDir)..\swagger\;$(_SwaggerIntermediateDirectory)" />

		<Exec
			EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development"
			Command="dotnet tool run swagger tofile --yaml --output &quot;%(_GeneratedSwaggerDocument.GeneratedPath)&quot; --openapiversion 3.0 &quot;$(TargetPath)&quot; %(_GeneratedSwaggerDocument.Identity)"
			WorkingDirectory="$(ProjectDir)"
		/>

		<Move
			SourceFiles="@(_GeneratedSwaggerDocument->'%(GeneratedPath)')"
			DestinationFiles="@(_GeneratedSwaggerDocument->'%(OutputPath)')"
		/>

		<RemoveDir Directories="$(_SwaggerIntermediateDirectory)" />
	</Target>
</Project>
