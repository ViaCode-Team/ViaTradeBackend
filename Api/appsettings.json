{
  "Database": {
    "MaxRetryCount": 2,
    "MaxRetryDelaySeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ViaTradeBackend.Middleware.ExceptionHandlingMiddleware": "Information"
    }
  },
  "Jwt": {
    "Issuer": "ViaTrade",
    "Audience": "ViaTradeClient",
    "AccessTokenMinutes": 60
  },
  "AuthCookies": {
    "AccessTokenCookie": "access_token",
    "RefreshTokenCookie": "refresh_token",
    "RefreshTokenExpiryDays": 7,
    "AbsoluteSessionLifetimeDays": 30
  },
  "TelegramBot": {
    "BotUsername": "ViaTradeBot"
  },
  "TelegramNotifications": {
    "RedisDatabase": 1,
    "StreamName": "telegram:notifications",
    "MaxLength": 100000,
    "ReminderPublishIntervalSeconds": 30
  },
  "ReminderCleanup": {
    "RetentionDays": 30,
    "CleanupIntervalHours": 24
  },
  "ReminderLimits": {
    "MaxRemindersPerUser": 3000
  }
}
