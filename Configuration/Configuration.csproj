		<RootNamespace>ViaTrade.Configuration</RootNamespace>
		<AssemblyName>ViaTrade.Configuration</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
